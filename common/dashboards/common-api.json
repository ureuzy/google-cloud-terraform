{
  "displayName": "common-api",
  "mosaicLayout": {
    "columns": 48,
    "tiles": [
      {
        "height": 7,
        "width": 48,
        "widget": {
          "title": "common-api",
          "text": {
            "content": "家族のアプリ (home) の API。**どの API のどこに時間がかかっているか**は [Trace エクスプローラ](https://console.cloud.google.com/traces/explorer?project=ureuzy-common) で見る (サービス common-api)。止まっていたあとの最初のリクエストは、写真の一覧などを読み込むので遅い (起動時間・インスタンス数を見る)。",
            "format": "MARKDOWN",
            "style": {}
          }
        }
      },
      {
        "yPos": 7,
        "height": 8,
        "width": 12,
        "widget": {
          "title": "リクエスト (1 時間)",
          "scorecard": {
            "sparkChartView": {
              "sparkChartType": "SPARK_LINE"
            },
            "timeSeriesQuery": {
              "timeSeriesFilter": {
                "aggregation": {
                  "alignmentPeriod": "3600s",
                  "crossSeriesReducer": "REDUCE_SUM",
                  "perSeriesAligner": "ALIGN_SUM"
                },
                "filter": "metric.type=\"run.googleapis.com/request_count\" AND resource.type=\"cloud_run_revision\" AND resource.label.\"service_name\"=\"common-api\""
              }
            }
          }
        }
      },
      {
        "yPos": 7,
        "xPos": 12,
        "height": 8,
        "width": 12,
        "widget": {
          "title": "エラー 5xx (1 時間)",
          "scorecard": {
            "sparkChartView": {
              "sparkChartType": "SPARK_LINE"
            },
            "timeSeriesQuery": {
              "timeSeriesFilter": {
                "aggregation": {
                  "alignmentPeriod": "3600s",
                  "crossSeriesReducer": "REDUCE_SUM",
                  "perSeriesAligner": "ALIGN_SUM"
                },
                "filter": "metric.type=\"run.googleapis.com/request_count\" AND resource.type=\"cloud_run_revision\" AND resource.label.\"service_name\"=\"common-api\" AND metric.label.\"response_code_class\"=\"5xx\""
              }
            }
          }
        }
      },
      {
        "yPos": 7,
        "xPos": 24,
        "height": 8,
        "width": 12,
        "widget": {
          "title": "応答時間 p95 (ms・1 時間)",
          "scorecard": {
            "sparkChartView": {
              "sparkChartType": "SPARK_LINE"
            },
            "timeSeriesQuery": {
              "timeSeriesFilter": {
                "aggregation": {
                  "alignmentPeriod": "3600s",
                  "crossSeriesReducer": "REDUCE_PERCENTILE_95",
                  "perSeriesAligner": "ALIGN_DELTA"
                },
                "filter": "metric.type=\"run.googleapis.com/request_latencies\" AND resource.type=\"cloud_run_revision\" AND resource.label.\"service_name\"=\"common-api\""
              }
            }
          }
        }
      },
      {
        "yPos": 7,
        "xPos": 36,
        "height": 8,
        "width": 12,
        "widget": {
          "title": "インスタンス (今)",
          "scorecard": {
            "sparkChartView": {
              "sparkChartType": "SPARK_LINE"
            },
            "timeSeriesQuery": {
              "timeSeriesFilter": {
                "aggregation": {
                  "alignmentPeriod": "60s",
                  "crossSeriesReducer": "REDUCE_SUM",
                  "perSeriesAligner": "ALIGN_MAX"
                },
                "filter": "metric.type=\"run.googleapis.com/container/instance_count\" AND resource.type=\"cloud_run_revision\" AND resource.label.\"service_name\"=\"common-api\""
              }
            }
          }
        }
      },
      {
        "yPos": 15,
        "height": 16,
        "width": 24,
        "widget": {
          "title": "応答時間 (ms)",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "legendTemplate": "p50",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_50",
                      "perSeriesAligner": "ALIGN_DELTA"
                    },
                    "filter": "metric.type=\"run.googleapis.com/request_latencies\" AND resource.type=\"cloud_run_revision\" AND resource.label.\"service_name\"=\"common-api\""
                  }
                }
              },
              {
                "legendTemplate": "p95",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_95",
                      "perSeriesAligner": "ALIGN_DELTA"
                    },
                    "filter": "metric.type=\"run.googleapis.com/request_latencies\" AND resource.type=\"cloud_run_revision\" AND resource.label.\"service_name\"=\"common-api\""
                  }
                }
              },
              {
                "legendTemplate": "p99",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_99",
                      "perSeriesAligner": "ALIGN_DELTA"
                    },
                    "filter": "metric.type=\"run.googleapis.com/request_latencies\" AND resource.type=\"cloud_run_revision\" AND resource.label.\"service_name\"=\"common-api\""
                  }
                }
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "label": "ms",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "yPos": 15,
        "xPos": 24,
        "height": 16,
        "width": 24,
        "widget": {
          "title": "リクエスト (応答の種類ごと)",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "legendTemplate": "${metric.labels.response_code_class}",
                "plotType": "STACKED_BAR",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.\"response_code_class\""
                      ],
                      "perSeriesAligner": "ALIGN_RATE"
                    },
                    "filter": "metric.type=\"run.googleapis.com/request_count\" AND resource.type=\"cloud_run_revision\" AND resource.label.\"service_name\"=\"common-api\""
                  }
                }
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "label": "回/秒",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "yPos": 31,
        "height": 16,
        "width": 24,
        "widget": {
          "title": "インスタンス (動いている・待っている)",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "legendTemplate": "${metric.labels.state}",
                "plotType": "STACKED_AREA",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.\"state\""
                      ],
                      "perSeriesAligner": "ALIGN_MAX"
                    },
                    "filter": "metric.type=\"run.googleapis.com/container/instance_count\" AND resource.type=\"cloud_run_revision\" AND resource.label.\"service_name\"=\"common-api\""
                  }
                }
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "yPos": 31,
        "xPos": 24,
        "height": 16,
        "width": 24,
        "widget": {
          "title": "起動にかかった時間 (ms。止まっていたあとの最初のリクエスト)",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "legendTemplate": "p95",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_95",
                      "perSeriesAligner": "ALIGN_DELTA"
                    },
                    "filter": "metric.type=\"run.googleapis.com/container/startup_latencies\" AND resource.type=\"cloud_run_revision\" AND resource.label.\"service_name\"=\"common-api\""
                  }
                }
              },
              {
                "legendTemplate": "p50",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_50",
                      "perSeriesAligner": "ALIGN_DELTA"
                    },
                    "filter": "metric.type=\"run.googleapis.com/container/startup_latencies\" AND resource.type=\"cloud_run_revision\" AND resource.label.\"service_name\"=\"common-api\""
                  }
                }
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "label": "ms",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "yPos": 47,
        "height": 16,
        "width": 16,
        "widget": {
          "title": "CPU 使用率",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "legendTemplate": "p95",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_95",
                      "perSeriesAligner": "ALIGN_DELTA"
                    },
                    "filter": "metric.type=\"run.googleapis.com/container/cpu/utilizations\" AND resource.type=\"cloud_run_revision\" AND resource.label.\"service_name\"=\"common-api\""
                  }
                }
              },
              {
                "legendTemplate": "p50",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_50",
                      "perSeriesAligner": "ALIGN_DELTA"
                    },
                    "filter": "metric.type=\"run.googleapis.com/container/cpu/utilizations\" AND resource.type=\"cloud_run_revision\" AND resource.label.\"service_name\"=\"common-api\""
                  }
                }
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "yPos": 47,
        "xPos": 16,
        "height": 16,
        "width": 16,
        "widget": {
          "title": "メモリ使用率 (上限 512 MiB)",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "legendTemplate": "p99",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_99",
                      "perSeriesAligner": "ALIGN_DELTA"
                    },
                    "filter": "metric.type=\"run.googleapis.com/container/memory/utilizations\" AND resource.type=\"cloud_run_revision\" AND resource.label.\"service_name\"=\"common-api\""
                  }
                }
              },
              {
                "legendTemplate": "p50",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_50",
                      "perSeriesAligner": "ALIGN_DELTA"
                    },
                    "filter": "metric.type=\"run.googleapis.com/container/memory/utilizations\" AND resource.type=\"cloud_run_revision\" AND resource.label.\"service_name\"=\"common-api\""
                  }
                }
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "yPos": 47,
        "xPos": 32,
        "height": 16,
        "width": 16,
        "widget": {
          "title": "課金されるインスタンス時間 (秒/秒)",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "legendTemplate": "billable",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "perSeriesAligner": "ALIGN_RATE"
                    },
                    "filter": "metric.type=\"run.googleapis.com/container/billable_instance_time\" AND resource.type=\"cloud_run_revision\" AND resource.label.\"service_name\"=\"common-api\""
                  }
                }
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "yPos": 63,
        "height": 16,
        "width": 24,
        "widget": {
          "title": "写真のバケット: API リクエスト (種類ごと)",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "legendTemplate": "${metric.labels.method}",
                "plotType": "STACKED_BAR",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.\"method\""
                      ],
                      "perSeriesAligner": "ALIGN_RATE"
                    },
                    "filter": "metric.type=\"storage.googleapis.com/api/request_count\" AND resource.type=\"gcs_bucket\" AND resource.label.\"bucket_name\"=\"ureuzy-family-photos\""
                  }
                }
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "label": "回/秒",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "yPos": 63,
        "xPos": 24,
        "height": 16,
        "width": 24,
        "widget": {
          "title": "写真のバケット: 外へ送った量 (写真の表示など)",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "legendTemplate": "sent",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "perSeriesAligner": "ALIGN_RATE"
                    },
                    "filter": "metric.type=\"storage.googleapis.com/network/sent_bytes_count\" AND resource.type=\"gcs_bucket\" AND resource.label.\"bucket_name\"=\"ureuzy-family-photos\""
                  }
                }
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "label": "bytes/秒",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "yPos": 79,
        "height": 20,
        "width": 48,
        "widget": {
          "title": "エラーのログ",
          "logsPanel": {
            "filter": "resource.type=\"cloud_run_revision\"\nresource.labels.service_name=\"common-api\"\nseverity>=ERROR",
            "resourceNames": [
              "projects/ureuzy-common"
            ]
          }
        }
      },
      {
        "yPos": 99,
        "height": 16,
        "width": 24,
        "widget": {
          "title": "API ごとの応答時間（グラフ：横は start_time、縦は ms の 95 パーセンタイル、分け方は name）",
          "timeSeriesTable": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "opsAnalyticsQuery": {
                    "sql": "SELECT start_time, trace_id, name, duration_nano / 1e6 AS ms\nFROM `ureuzy-common.us._Trace.Spans._AllSpans`\nWHERE JSON_VALUE(attributes, '$.\"service.name\"') = 'common-api'\n  AND kind = 2  -- リクエスト (サーバー) のスパン"
                  }
                }
              }
            ],
            "metricVisualization": "NUMBER"
          }
        }
      },
      {
        "yPos": 99,
        "xPos": 24,
        "height": 16,
        "width": 24,
        "widget": {
          "title": "時間がかかっている処理の順位（テーブル、または棒グラフ）",
          "timeSeriesTable": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "opsAnalyticsQuery": {
                    "sql": "SELECT name,\n  COUNT(*) AS n,\n  ROUND(SUM(duration_nano) / 1e9, 1) AS total_s,\n  ROUND(APPROX_QUANTILES(duration_nano, 100)[OFFSET(95)] / 1e6) AS p95_ms\nFROM `ureuzy-common.us._Trace.Spans._AllSpans`\nWHERE JSON_VALUE(attributes, '$.\"service.name\"') = 'common-api'\n  AND kind != 2\nGROUP BY name\nORDER BY total_s DESC\nLIMIT 15"
                  }
                }
              }
            ],
            "metricVisualization": "NUMBER"
          }
        }
      },
      {
        "yPos": 115,
        "height": 16,
        "width": 24,
        "widget": {
          "title": "遅かったリクエスト（1 秒以上）（テーブル）",
          "timeSeriesTable": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "opsAnalyticsQuery": {
                    "sql": "SELECT start_time, name, ROUND(duration_nano / 1e6) AS ms, trace_id\nFROM `ureuzy-common.us._Trace.Spans._AllSpans`\nWHERE JSON_VALUE(attributes, '$.\"service.name\"') = 'common-api'\n  AND kind = 2\n  AND duration_nano > 1e9\nORDER BY start_time DESC\nLIMIT 50"
                  }
                }
              }
            ],
            "metricVisualization": "NUMBER"
          }
        }
      }
    ]
  }
}
