{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "packageRules": [
    {
      "matchManagers": [
        "terraform"
      ],
      "groupName": "google provider",
      "matchPackageNames": [
        "/google/"
      ]
    },
    {
      "matchManagers": [
        "terraform"
      ],
      "groupName": "google modules",
      "matchPackageNames": [
        "/terraform-google-modules/"
      ]
    },
    {
      "matchManagers": [
        "asdf",
        "terraform-version"
      ],
      "matchPackageNames": [
        "terraform"
      ],
      "groupName": "terraform"
    }
  ]
}
