{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  "dependencyDashboard": true,
  "packageRules": [
    {
      "matchManagers": ["terraform"],
      "matchPackagePatterns": ["google"],
      "groupName": "google provider"
    },
    {
      "matchManagers": ["terraform"],
      "matchPackagePatterns": ["terraform-google-modules"],
      "groupName": "google modules"
    },
    {
      "matchManagers": ["asdf", "terraform-version"],
      "matchPackageNames": ["terraform"],
      "groupName": "terraform"
    }
  ]
}
